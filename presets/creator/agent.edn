{:plugins
 [{:ns agent.plugins.session
   :config {:path nil}}

  {:ns agent.plugins.session-title}

  {:ns agent.plugins.session-catalog}

  {:ns agent.plugins.auth-store}

  {:ns agent.plugins.model-registry
   :config {:default-provider :chatgpt}}

  {:ns agent.plugins.openai-responses
   :config {:model "gpt-5.6-sol"
            :api-key-env "OPENAI_API_KEY"
            :timeout-ms 180000
            :max-retries 2
            :retry-delay-ms 500
            :extra-body {:reasoning {:effort "medium"}}}}

  {:ns agent.plugins.openai
   :config {:base-url "https://api.deepseek.com"
            :provider-id :deepseek
            :api-key-env "DEEPSEEK_API_KEY"
            :model "deepseek-v4-flash"
            :context-window 1000000
            :thinking-levels [:off :low :high :max]
            :timeout-ms 180000
            :extra-body {:thinking {:type "disabled"}}}}

  ;; Optional experimental fallback that reuses a local Codex/ChatGPT login.
  {:ns agent.plugins.chatgpt
   :config {:model "gpt-5.6-sol"
            :timeout-ms 180000
            :connect-timeout-ms 15000
            :http-version :http1.1
            :transport-retries 4
            :retry-delay-ms 400
            :extra-body {:reasoning {:effort "medium"}}}}

  ;; Web-managed providers are stored outside the repository with mode 0600.
  ;; When DAO_PROVIDER_SETTINGS_FILE is unset this plugin is a no-op.
  {:ns agent.plugins.provider-settings}

  {:ns agent.plugins.execution-world
   :config {:root "."
            :timeout-ms 30000
            :max-output-chars 50000}}

  {:ns agent.plugins.trust
   :config {:root "."}}

  ;; Language servers are optional external executables. Missing binaries are
  ;; reported by /lsp status and never prevent the agent from starting.
  {:ns agent.plugins.stdio-session
   :config {:stderr-tail-chars 20000
            :close-timeout-ms 1000}}

  {:ns agent.plugins.lsp
   :config
   {:request-timeout-ms 10000
    :startup-timeout-ms 30000
    :max-document-chars 2000000
    :servers
    [{:id :clojure-lsp
      :command "clojure-lsp"
      :file-types [".clj" ".cljs" ".cljc" ".edn"]
      :language-id "clojure"
      :root-markers ["deps.edn" "bb.edn" "project.clj" ".git"]}
     {:id :rust-analyzer
      :command "rust-analyzer"
      :file-types [".rs"]
      :language-id "rust"
      :root-markers ["Cargo.toml" "rust-project.json" ".git"]}
     {:id :clangd
      :command "clangd"
      :file-types [".c" ".cc" ".cpp" ".cxx" ".h" ".hh" ".hpp"]
      :language-id {".c" "c" ".h" "c"
                    ".cc" "cpp" ".cpp" "cpp" ".cxx" "cpp"
                    ".hh" "cpp" ".hpp" "cpp"}
      :root-markers ["compile_commands.json" "compile_flags.txt" ".clangd" ".git"]}
     {:id :typescript-language-server
      :command ["typescript-language-server" "--stdio"]
      :file-types [".ts" ".tsx" ".js" ".jsx" ".mjs" ".cjs"]
      :language-id {".ts" "typescript" ".tsx" "typescriptreact"
                    ".js" "javascript" ".jsx" "javascriptreact"
                    ".mjs" "javascript" ".cjs" "javascript"}
      :root-markers ["tsconfig.json" "jsconfig.json" "package.json" ".git"]}
     {:id :pyright
      :command ["pyright-langserver" "--stdio"]
      :file-types [".py" ".pyi"]
      :language-id "python"
      :root-markers ["pyproject.toml" "setup.py" "requirements.txt" ".git"]}]}}

  {:ns agent.plugins.lsp-tools}

  {:ns agent.plugins.tools
   :config {:max-read-chars 50000}}

  {:ns agent.plugins.omp
   :config {:max-file-chars 500000
            :max-edits 32
            ;; Leave :default unrouted so /model controls normal turns.
            ;; Named roles may still use fallback vectors such as
            ;; :plan [:openai :chatgpt].
            :default-role :default}}

  ;; DeepSeek Harness-style subagents are split into a provider-neutral
  ;; registry, isolated spawn/fork providers, and model-facing tool adapters.
  {:ns agent.plugins.subagent}

  {:ns agent.plugins.subagent-in-process
   :config
   {:max-depth 1
    ;; A request may narrow this set but can never expand it. Mutating and
    ;; general process tools remain unavailable to unattended child agents;
    ;; bb_repl is confined to the child's own sandbox and namespace.
    :allowed-tools ["current_time" "read" "read_file" "ls" "find" "grep"
                    "load_skill" "bb_repl"]
    :child-profile
    {:plugins
     [{:ns agent.plugins.session :config {:path nil :ephemeral true}}
      {:ns agent.plugins.model-registry
       :config {:default-provider :chatgpt}}
      {:ns agent.plugins.openai-responses
       :config {:model "gpt-5.6-sol"
                :api-key-env "OPENAI_API_KEY"
                :timeout-ms 180000
                :max-retries 2
                :retry-delay-ms 500
                :extra-body {:reasoning {:effort "medium"}}}}
      {:ns agent.plugins.openai
       :config {:base-url "https://api.deepseek.com"
                :provider-id :deepseek
                :api-key-env "DEEPSEEK_API_KEY"
                :model "deepseek-v4-flash"
                :context-window 1000000
                :thinking-levels [:off :low :high :max]
                :timeout-ms 180000
                :extra-body {:thinking {:type "disabled"}}}}
      {:ns agent.plugins.chatgpt
       :config {:model "gpt-5.6-sol"
                :timeout-ms 180000
                :connect-timeout-ms 15000
                :http-version :http1.1
                :transport-retries 4
                :retry-delay-ms 400
                :extra-body {:reasoning {:effort "medium"}}}}
      {:ns agent.plugins.provider-settings}
      {:ns agent.plugins.execution-world
       :config {:root "."
                :timeout-ms 30000
                :max-output-chars 50000}}
      {:ns agent.plugins.tools
       :config {:max-read-chars 50000}}
      {:ns agent.plugins.durable-state
       :config {:root "."}}
      {:ns agent.plugins.bb-repl
       ;; `dao --repl-backend jvm-clojure` 会为新 agent 覆盖默认 backend。
       :config {:root "."
                :sandbox :auto
                :timeout-ms 10000
                :max-output-chars 20000}}
      {:ns agent.plugins.clojure-repl}
      {:ns agent.plugins.context-manager
       :config {:context-window 128000
                :reserve-tokens 16384
                :retain-messages 12}}
      {:ns agent.plugins.runtime
       :config {:max-steps 8
                :system-prompt
                "You are an isolated research subagent. Complete the delegated task with the available read-only tools, report concrete evidence, and do not claim to have changed files."}}]}}}

  {:ns agent.plugins.subagent-tools}

  {:ns agent.plugins.durable-state
   :config {:root "."}}

  {:ns agent.plugins.bb-repl
   ;; 也可直接替换为 agent.plugins.jvm-clojure-repl。
   :config {:root "."
            :sandbox :auto
            :timeout-ms 10000
            :max-output-chars 20000}}

  {:ns agent.plugins.clojure-repl}

  {:ns agent.plugins.resources
   :config {:root "."
            :skills {:bundled-directories ["presets/creator/skills"]}}}

  ;; Creator-only, read-only view of the current Kernel topology. It exposes
  ;; ownership metadata but never service values, functions, or configuration.
  {:ns agent.plugins.runtime-inspect}

  ;; Runtime experiments accept audited built-ins or bounded EDN Blueprints.
  ;; Blueprints are compiled data programs, never evaluated Clojure source.
  {:ns agent.plugins.runtime-lab
   :config {:allow [{:ns agent.plugins.math}]
            :blueprints {:enabled true
                         :max-source-chars 30000
                         :max-tools 8
                         :max-ast-nodes 512
                         :max-depth 24
                         :max-value-nodes 4096
                         :max-collection-items 256
                         :max-string-chars 50000
                         :max-number-magnitude 1.0e15}}}

  ;; System presets ship with DAO; user-authored copies live under ~/.dao.
  {:ns agent.plugins.presets}

  ;; Creator sessions can inspect, copy, atomically update, validate, and
  ;; delete user presets without exposing arbitrary host filesystem access.
  {:ns agent.plugins.preset-author}

  ;; Remote methods are frontend-neutral. RPC mode inserts a remote interaction
  ;; bridge before approval so the worker never reads prompts from stdin.
  {:ns agent.plugins.remote-registry}

  {:ns agent.plugins.approval
   ;; Change to :ask for a confirmation before each bb_repl call.
   :config {:mode :allow}}

  {:ns agent.plugins.policy
   :config {:deny-tools []
            :trusted-tools ["write" "edit" "hash_edit" "bash" "bb_repl"
                            "preset_author"
                            "lsp_query"]
            :approval-tools ["write" "edit" "hash_edit" "bash" "bb_repl"
                             "preset_author"]}}

  {:ns agent.plugins.trace
   :config {:enabled true
            :show-results true}}

  {:ns agent.plugins.stream-console}

  {:ns agent.plugins.context-manager
   :config {:context-window 128000
            :reserve-tokens 16384
            :retain-messages 12}}

  {:ns agent.plugins.runtime
   :config {:max-steps 12
            :system-prompt-template :omp
            :append-system-prompt
            "You are running in DAO Creator mode. Before creating or changing an Agent preset, load the creating-agent-presets skill and call preset_guide; inspect the roster and source with preset_inspect, copy a healthy base with preset_author, then update only the user-owned copy and validate it. Before defining a runtime EDN Blueprint, load the creating-runtime-blueprints skill. A preset is per-Session composition; shared registries, persistence, credentials, sandbox, approval, and model routing belong to the host profile. Use runtime_inspect as the authoritative read-only view of loaded plugins, tools, services, commands, and hooks before making claims about runtime topology. runtime_plugin can version and hot-swap audited built-ins or bounded EDN Blueprint tools; inspect the runtime after activation or rollback. Never expose or infer service values, credentials, executable functions, or private configuration. System presets are read-only. Blueprints are data programs: arbitrary namespaces, Vars, Java interop, filesystem, network, eval, and load-string are not supported. Never claim an activation, update, rollback, or deactivation succeeded unless the corresponding tool returned success."}}

  {:ns agent.plugins.remote-api}]}
