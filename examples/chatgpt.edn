{:plugins
 [{:ns qi.plugins.session}

  {:ns qi.plugins.session-catalog}

  {:ns qi.plugins.auth-store}

  {:ns qi.plugins.model-registry
   :config {:default-provider :chatgpt}}

  {:ns qi.plugins.chatgpt
   :config {:model "gpt-5.6-sol"
            :timeout-ms 180000
            :extra-body {:reasoning {:effort "medium"}}}}

  {:ns qi.plugins.execution-world
   :config {:root "."}}

  {:ns qi.plugins.tools
   :config {:max-read-chars 50000}}

  {:ns qi.plugins.bb-repl
   :config {:root "."
            :sandbox :auto
            :timeout-ms 10000
            :max-output-chars 20000}}

  {:ns qi.plugins.clojure-repl}

  {:ns qi.plugins.math}

  {:ns qi.plugins.trust
   :config {:root "." :trusted true}}

  {:ns qi.plugins.resources
   :config {:root "."}}

  {:ns qi.plugins.approval
   :config {:mode :allow}}

  {:ns qi.plugins.policy
   :config {:deny-tools []
            :trusted-tools ["write" "edit" "bash" "bb_repl"]
            :approval-tools ["write" "edit" "bash" "bb_repl"]}}

  {:ns qi.plugins.trace
   :config {:enabled true
            :show-results true}}

  {:ns qi.plugins.stream-console}

  {:ns qi.plugins.context-manager}

  {:ns qi.plugins.runtime
   :config {:max-steps 12
            :system-prompt
            "You are a concise coding assistant. Use tools when they improve accuracy. Use bb_repl for exact calculations and Clojure data transformations. Never invent tool results."}}]}
