{:plugins
 [{:ns agent.plugins.session
   :config {:path nil}}

  {:ns agent.plugins.session-catalog}

  {:ns agent.plugins.auth-store}

  {:ns agent.plugins.model-registry
   :config {:default-provider :deepseek}}

  {:ns agent.plugins.openai
   :config {:base-url "https://api.deepseek.com"
            :provider-id :deepseek
            :api-key-env "DEEPSEEK_API_KEY"
            :model "deepseek-v4-flash"
            :thinking-levels [:off :low :high :max]
            :timeout-ms 120000
            :extra-body {:thinking {:type "disabled"}}}}

  {:ns agent.plugins.execution-world
   :config {:root "."}}

  {:ns agent.plugins.tools
   :config {:max-read-chars 50000}}

  {:ns agent.plugins.bb-repl
   :config {:root "."
            :sandbox :auto
            :timeout-ms 10000
            :max-output-chars 20000}}

  {:ns agent.plugins.clojure-repl}

  {:ns agent.plugins.math}

  {:ns agent.plugins.trust
   :config {:root "." :trusted true}}

  {:ns agent.plugins.resources
   :config {:root "."}}

  {:ns agent.plugins.approval
   :config {:mode :allow}}

  {:ns agent.plugins.policy
   :config {:deny-tools []
            :trusted-tools ["write" "edit" "bash" "bb_repl"]
            :approval-tools ["write" "edit" "bash" "bb_repl"]}}

  {:ns agent.plugins.trace
   :config {:enabled true
            :show-results true}}

  {:ns agent.plugins.stream-console}

  {:ns agent.plugins.context-manager}

  {:ns agent.plugins.runtime
   :config {:max-steps 12
            :system-prompt
            "You are a concise coding assistant. Use tools when they improve accuracy. Use bb_repl for exact calculations and Clojure data transformations. Never invent tool results."}}]}
