#!/usr/bin/expect -f

log_user 0
set timeout 10

set repo_root [file normalize [file join [file dirname [info script]] ../../..]]
cd $repo_root
set capture_path [file join /tmp "qi-agent-tui-pty-[pid].log"]
set runtime_path [file join /tmp "qi-agent-pty-runtime-[pid]"]
set state_path [file join /tmp "qi-agent-pty-state-[pid]"]
set workspace_path [file join /tmp "qi-agent-pty-workspace-[pid]"]
file mkdir $runtime_path
file mkdir $state_path
file mkdir $workspace_path
# `log_user 0` keeps the CI output readable; `-a` still records the raw PTY
# stream so terminal-mode setup and restoration can be asserted byte-for-byte.
log_file -a -noappend $capture_path

proc fail {message code} {
    global capture_path runtime_path state_path workspace_path repo_root
    puts stderr $message
    catch {send -- "\003"}
    after 100
    catch {send -- "\003"}
    catch {exec env QI_AGENT_RUNTIME_DIR=$runtime_path QI_AGENT_STATE_DIR=$state_path \
        [file join $repo_root apps tui-rs target release qi-agent] shutdown --repository-root $repo_root \
        --config [file join $repo_root examples tui-mock.edn]}
    puts stderr "terminal capture: $capture_path"
    catch {file delete -force $runtime_path}
    catch {file delete -force $state_path}
    catch {file delete -force $workspace_path}
    exit $code
}

# Some non-interactive Expect hosts create the child PTY at 0x0, so Ratatui's
# first frame would correctly contain no cells. Configure the spawned slave.
cd $workspace_path
spawn -noecho env QI_AGENT_RUNTIME_DIR=$runtime_path QI_AGENT_STATE_DIR=$state_path \
    [file join $repo_root apps tui-rs target release qi-agent] --repository-root $repo_root \
    --config [file join $repo_root examples tui-mock.edn]
stty rows 44 columns 160 < $spawn_out(slave,name)

# The native-scrollback fallback asks for the real terminal cursor row. Keep a
# response installed so this smoke test also catches an accidental fallback.
expect_before {
    -re "\x1b\\\[6n" {
        send -- "\x1b\[1;1R"
        exp_continue
    }
}

expect {
    "Tips:" { puts "startup: rendered" }
    timeout { fail "startup: timed out" 2 }
    eof { fail "startup: early exit" 3 }
}

# Exercise virtual-history resize while the TUI is live.
stty rows 28 columns 160 < $spawn_out(slave,name)
exec kill -WINCH [exp_pid]
after 100

send -- "hello\r"
expect {
    # Ratatui may place cursor/style sequences between adjacent words, so use
    # the final stable token instead of matching a multi-word phrase.
    "summary." { puts "turn: rendered" }
    timeout { fail "turn: timed out" 4 }
    eof { fail "turn: early exit" 5 }
}

stty rows 52 columns 160 < $spawn_out(slave,name)
exec kill -WINCH [exp_pid]
after 100

send -- "\004"
expect {
    eof {
        log_file
        set capture [open $capture_path rb]
        set terminal_output [read $capture]
        close $capture
        if {[string first "\x1b\[?1049h" $terminal_output] < 0} {
            fail "terminal: alternate screen was not enabled" 7
        }
        if {[string first "\x1b\[?1049l" $terminal_output] < 0} {
            fail "terminal: alternate screen was not restored" 8
        }
        if {[string first "\x1b\[?1006h" $terminal_output] < 0} {
            fail "terminal: mouse capture was not enabled" 9
        }
        if {[string first "\x1b\[?1006l" $terminal_output] < 0} {
            fail "terminal: mouse capture was not restored" 10
        }
        catch {exec env QI_AGENT_RUNTIME_DIR=$runtime_path QI_AGENT_STATE_DIR=$state_path \
            [file join $repo_root apps tui-rs target release qi-agent] shutdown --repository-root $repo_root \
            --config [file join $repo_root examples tui-mock.edn]}
        file delete -force $runtime_path
        file delete -force $state_path
        file delete -force $workspace_path
        file delete -force $capture_path
        puts "history: virtualized"
        puts "exit: clean"
    }
    timeout { fail "exit: timed out" 6 }
}
