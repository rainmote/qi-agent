{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qi-agent",
  "version": "0.1.0",
  "identifier": "dev.rainmote.qi-agent.desktop",
  "build": { "frontendDist": "../bootstrap" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": ["no-renderer-native"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": { "../stage/runtime/": "runtime/" },
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
