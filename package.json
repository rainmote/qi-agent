{
  "name": "@rainmote/qi-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:web && npm run test:web-ui && npm run test:desktop-unit && npm run test:acp && npm run test:tui && npm run test:desktop-rust && bb test && npm run test:eval && npm run test:maintenance",
    "maintenance": "node maintenance/run.mjs",
    "test:maintenance": "node --test maintenance/tests/*.test.mjs",
    "test:maintenance:docker": "node maintenance/container-smoke.mjs",
    "acp": "tsx apps/acp/server.ts",
    "test:lcu-e2e": "bb test-lcu-e2e",
    "test:acp": "tsx --test apps/acp/*.test.ts",
    "tui:build": "cargo build --release --manifest-path apps/tui-rs/Cargo.toml",
    "web": "npm run tui:build && npm run web:build && npm run web:start",
    "web:build": "vite build",
    "web:start": "tsx apps/web-host/server.ts",
    "typecheck": "tsc --noEmit",
    "test:web": "cargo build --manifest-path apps/tui-rs/Cargo.toml && QI_AGENT_BIN=\"$PWD/apps/tui-rs/target/debug/qi-agent\" tsx --test apps/web-host/*.test.ts",
    "test:web-ui": "tsx --test apps/web/src/*.test.tsx",
    "test:tui": "cargo test --manifest-path apps/tui-rs/Cargo.toml",
    "test:web-browser": "node apps/web/tests/browser-regressions.mjs",
    "test:web-browser:ci": "node apps/web/tests/production-browser.mjs",
    "test:web-e2e": "npm run web:build && cargo build --locked --manifest-path apps/tui-rs/Cargo.toml && tsx --test apps/web/tests/interaction-e2e.test.ts",
    "test:eval": "node --test evals/tests/*.test.mjs",
    "eval:doctor": "node evals/run.mjs doctor",
    "eval:validate": "node evals/run.mjs validate",
    "eval:smoke": "node evals/run.mjs smoke",
    "desktop:bootstrap": "node scripts/desktop/bootstrap.mjs",
    "desktop:prepare": "node scripts/desktop/build.mjs prepare",
    "desktop:build": "node scripts/desktop/build.mjs build",
    "desktop:build-app": "node scripts/desktop/build.mjs build-app",
    "desktop:dev": "node scripts/desktop/build.mjs dev",
    "desktop:verify": "node scripts/desktop/build.mjs verify",
    "desktop:fetch-workspace": "python3 scripts/desktop/runtime-fetch.py",
    "test:desktop-fetch": "python3 test/desktop_runtime_fetch_test.py -v",
    "test:desktop-unit": "tsx --test apps/desktop/*.test.ts",
    "test:desktop-rust": "cargo test --locked --manifest-path apps/desktop/supervisor/Cargo.toml --lib",
    "desktop:prepare-preview": "node scripts/desktop/build.mjs prepare-preview",
    "desktop:build-preview": "node scripts/desktop/build.mjs build-preview-app",
    "desktop:verify-preview": "node scripts/desktop/build.mjs verify-preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  }
}
