{
  "name": "bb-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:web && npm run test:web-ui && npm run test:tui && bb test",
    "tui:build": "cargo build --release --manifest-path apps/tui-rs/Cargo.toml",
    "web": "npm run tui:build && npm run web:build && npm run web:start",
    "web:build": "vite build",
    "web:start": "tsx apps/web-host/server.ts",
    "typecheck": "tsc --noEmit",
    "test:web": "cargo build --manifest-path apps/tui-rs/Cargo.toml && DAO_BIN=\"$PWD/apps/tui-rs/target/debug/dao\" tsx --test apps/web-host/*.test.ts",
    "test:web-ui": "tsx --test apps/web/src/*.test.tsx",
    "test:tui": "cargo test --manifest-path apps/tui-rs/Cargo.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
