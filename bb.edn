{:paths ["src" "plugins"]
 :tasks
  {qi-agent {:doc "Run qì agent directly with Babashka"
             :requires ([qi.cli :as cli])
             :task (apply cli/entrypoint *command-line-args*)}
   agent {:doc "Compatibility alias for the qi-agent task"
          :requires ([qi.cli :as cli])
          :task (apply cli/entrypoint *command-line-args*)}
  install {:doc "Install qì agent for use from any workspace"
           :requires ([qi.install :as install])
           :task (apply install/entrypoint *command-line-args*)}
  update {:doc "Update the installed qì agent Git checkout"
          :requires ([qi.install :as install])
          :task (apply install/update-entrypoint *command-line-args*)}
  tui-build {:doc "Build the Qwen-style Ratatui frontend"
             :task (shell "cargo build --release --manifest-path apps/tui-rs/Cargo.toml")}
  tui-test {:doc "Run Ratatui unit/UI tests and the real-PTY smoke test"
            :task (do
                    (shell "cargo test --manifest-path apps/tui-rs/Cargo.toml")
                    (shell "cargo build --release --manifest-path apps/tui-rs/Cargo.toml")
                    (shell "expect apps/tui-rs/tests/pty-smoke.exp"))}
  test {:doc "Run the test suite"
        :extra-paths ["test"]
        :requires ([qi.test-runner :as test-runner])
        :task (test-runner/-main)}
  web {:doc "Build and start the local WebUI"
       :task (shell "npm run web")}}}
